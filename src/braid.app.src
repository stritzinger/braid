{application, braid,
 [{description, "An Erlang library to create and connect an arbitrary cluster of nodes"},
  {vsn, semver},
  {registered, []},
  {mod, {braid_app, []}},
  {applications,
   [kernel,
    stdlib,
    % legacy braid
    mapz,
    % cli
    argparse,
    color,
    % rest client
    jsx,
    certifi,
    inets,
    ssl
   ]},
  {env,[
    {scheme, "https"},
    {port, 443}
  ]},
  {modules, []},

  {licenses, ["Apache-2.0"]},
  {links,
    [{"Changelog", "https://github.com/stritzinger/braid/blob/master/CHANGELOG.md"},
     {"GitHub", "https://github.com/stritzinger/braid"}]}
 ]}.
